**/outputs/
**/output/
**/*.nc
**/*.h5
**/*.hdf5
**/*.npz
**/*.vtk
**/*.vtu
**/*.xdmf
**/*.zip
**/*.pvsm
**/*.tar.gz

# HPC deployment artefacts (large tarball) are not needed in the image
hpc-setup/
notebook_doc_prompt.md

# Docs build
docs/_build

# Misc
*.log
.DS_Store