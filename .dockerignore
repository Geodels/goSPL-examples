# VCS
.git
.github
.gitignore

# Devcontainer/editor cruft
.devcontainer
.vscode
.idea

# Python
**/__pycache__
**/*.py[cod]
**/*.pyc
**/*.egg-info
.pytest_cache
.mypy_cache

# Jupyter
**/.ipynb_checkpoints

